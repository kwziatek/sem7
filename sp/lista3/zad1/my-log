#include "program.h"

#define S279717_CM_W_CALU 2.54
#define S279717_BIG_MAC_CM 9.1
#define S279717_BIELIK_CM 230.0

void s279717_podprogram()
{
  double cm;
  long dziesiate_cala;

  printf("Michał Zakrzewski, 279717\n");
  printf("Program wczytuje wzrost w centymetrach i podaje go w stopach i calach,\n");
  printf("w Big Macach (9,1 cm wysokości) oraz w rozpiętościach skrzydeł\n");
  printf("bielika amerykańskiego (2,3 m).\n\n");
  printf("Podaj wzrost w cm: ");

  if(scanf("%lf", &cm) != 1)
    {
      printf("\nBłąd: to nie jest liczba.\n");
      return;
    }

  if(cm < 0)
    {
      printf("\nBłąd: wzrost nie może być ujemny.\n");
      return;
    }

  dziesiate_cala = (long)(cm / S279717_CM_W_CALU * 10 + 0.5);

  printf("\nWzrost %.1f cm to:\n", cm);
  printf("  %ld ft %ld.%ld in\n", dziesiate_cala / 120,
         dziesiate_cala % 120 / 10, dziesiate_cala % 10);
  printf("  %.2f Big Maców\n", cm / S279717_BIG_MAC_CM);
  printf("  %.2f rozpiętości skrzydeł bielika amerykańskiego\n",
         cm / S279717_BIELIK_CM);
}
